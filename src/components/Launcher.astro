---
import type { Project } from "../projects";
import ProjectTile from "./ProjectTile.astro";

interface Props {
  projects: Project[];
}
const { projects } = Astro.props;
---

<dialog class="launcher" data-launcher aria-labelledby="launcher-title">
  <div class="launcher-head">
    <h2 class="launcher-title" id="launcher-title">
      All projects
    </h2>
    <button
      type="button"
      class="launcher-close"
      data-launcher-close
      aria-label="Close"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18"></path>
      </svg>
    </button>
  </div>
  <ul class="launcher-grid">
    {projects.map((p, i) => (
      <li>
        <ProjectTile
          project={p}
          index={i}
          sizes="(max-width: 480px) 45vw, 400px"
          showYear
          showTags
          short="narrow"
        />
      </li>
    ))}
  </ul>
</dialog>
