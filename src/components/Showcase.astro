---
import { BOARD_PROJECTS, type Project } from "../projects";
import ProjectTile from "./ProjectTile.astro";

interface Props {
  projects: Project[];
}
const latest = Astro.props.projects.slice(0, BOARD_PROJECTS);
---

{latest.length > 0 && (
  <nav class="showcase" data-showcase aria-label="Latest projects">
    {latest.map((p, i) => (
      <ProjectTile project={p} index={i} sizes="140px" eager />
    ))}
  </nav>
)}
