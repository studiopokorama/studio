<dialog class="palette" data-palette aria-label="Commands">
  <div class="palette-log" data-palette-log aria-live="polite">
    <p>Type a command or pick one below.</p>
  </div>
  <label class="palette-prompt">
    <span aria-hidden="true">›</span>
    <input
      data-palette-input
      type="text"
      autocomplete="off"
      spellcheck="false"
      role="combobox"
      aria-controls="palette-list"
      aria-expanded="true"
      aria-label="Command"
    />
  </label>
  <ul
    class="palette-list"
    id="palette-list"
    data-palette-list
    role="listbox"
  ></ul>
</dialog>
