---
import { Image } from "astro:assets";
import { render } from "astro:content";
import type { Project } from "../projects";

interface Props {
  project: Project;
}
const { project } = Astro.props;
const { title, description, year, tags, images, youtube, links } = project.data;
const { Content } = await render(project);
const hasBody = !!project.body?.trim();
const items = images.length + youtube.length;
---

<article class="pv" data-view={project.id} aria-labelledby={`pv-${project.id}`}>
  <div class="pv-media">
    <div class="pv-stage" data-stage>
      {images.map((img, i) => (
        <figure class="pv-item" data-item hidden={i > 0}>
          <Image
            src={img.src}
            alt={img.alt}
            widths={[640, 960, 1280, 1600]}
            sizes="(min-width: 960px) 60vw, 100vw"
            loading={i === 0 ? "eager" : "lazy"}
            data-cover={i === 0 ? "" : undefined}
          />
        </figure>
      ))}
      {youtube.map((id, i) => (
        <figure class="pv-item pv-video" data-item data-youtube={id} hidden>
          <button type="button" class="pv-play" data-play>
            <img
              src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
              alt=""
              loading="lazy"
            />
            <span class="pv-play-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="28" height="28">
                <path d="M8 5.5v13l10.5-6.5z" />
              </svg>
            </span>
            <span class="sr-only">
              Play video {i + 1} of {title}
            </span>
          </button>
        </figure>
      ))}
    </div>
    {items > 1 && (
      <div class="pv-thumbs" role="group" aria-label="Media">
        {images.map((img, i) => (
          <button
            type="button"
            class="pv-thumb"
            data-thumb={i}
            aria-pressed={i === 0 ? "true" : "false"}
            aria-label={`Image ${i + 1}: ${img.alt}`}
          >
            <Image src={img.src} alt="" widths={[160]} sizes="80px" />
          </button>
        ))}
        {youtube.map((id, i) => (
          <button
            type="button"
            class="pv-thumb pv-thumb-video"
            data-thumb={images.length + i}
            aria-pressed="false"
            aria-label={`Video ${i + 1}`}
          >
            <img
              src={`https://i.ytimg.com/vi/${id}/mqdefault.jpg`}
              alt=""
              loading="lazy"
            />
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
              <path d="M8 5.5v13l10.5-6.5z" />
            </svg>
          </button>
        ))}
      </div>
    )}
  </div>

  <div class="pv-text">
    <h2 class="pv-title" id={`pv-${project.id}`}>
      {title}
    </h2>
    <p class="pv-meta">
      <span class="pv-year">{year}</span>
      {tags.map((t) => (
        <span class="pv-tag">{t}</span>
      ))}
    </p>
    <p class="pv-desc">{description}</p>
    {hasBody && (
      <div class="pv-body">
        <Content />
      </div>
    )}
    {links.length > 0 && (
      <div class="pv-links">
        {links.map((l, i) => (
          <a
            class={`btn ${i === 0 ? "btn-primary" : "btn-secondary"}`}
            href={l.href}
            target="_blank"
            rel="noopener"
          >
            {l.label}
          </a>
        ))}
      </div>
    )}
  </div>
</article>
