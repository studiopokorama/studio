---
// Head first: its base styles must come before this page's own.
import Head from "../components/Head.astro";
import "../styles/showcase.css";
import "../styles/doc.css";
import { getImage } from "astro:assets";
import DocOverlay from "../components/DocOverlay.astro";
import FootCopy from "../components/FootCopy.astro";
import Launcher from "../components/Launcher.astro";
import Mark from "../components/Mark.astro";
import Palette from "../components/Palette.astro";
import ProjectOverlay from "../components/ProjectOverlay.astro";
import Showcase from "../components/Showcase.astro";
import TopActions from "../components/TopActions.astro";
import Wordmark from "../components/Wordmark.astro";
import { getDocPages, type DocPage } from "../docs";
import type { Project } from "../projects";

interface Props {
  projects: Project[];
  /** A project page: the home page with this project open over it. */
  open?: Project;
  /** A text page (privacy, terms, about): the home page with it open over it. */
  doc?: DocPage;
}
const { projects, open, doc } = Astro.props;
const docPages = await getDocPages();

const description = open
  ? open.data.description
  : doc
    ? doc.data.description
    : "Studio Pokorama is an independent digital studio making apps, games, software and media.";
const cover = open
  ? await getImage({
      src: open.data.images[0]!.src,
      width: 1200,
      format: "jpg",
    })
  : null;
const image =
  open && cover ? { src: cover.src, alt: open.data.images[0]!.alt } : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title={open?.data.title ?? doc?.data.title}
      description={description}
      image={image}
    />
  </head>
  <body>
    <canvas class="board" data-board aria-hidden="true"></canvas>
    <div class="found-words" data-found aria-hidden="true"></div>

    <div class="page">
      <header class="top">
        <TopActions />
      </header>

      <main class="hero">
        <h1 class="sr-only">Studio Pokorama</h1>
        <Wordmark />
        <p class="lede">
          Apps, games and media.
          <br />
          Building piece by piece.
        </p>
        <Showcase projects={projects} />
      </main>

      <footer class="foot">
        <FootCopy />
        {projects.length > 0 && (
          <button
            type="button"
            class="apps-btn"
            data-launcher-open
            aria-haspopup="dialog"
            aria-label="All projects"
          >
            <Mark size={60} />
          </button>
        )}
        <span class="foot-actions">
          <button type="button" class="foot-btn" data-reset hidden>
            Reset
          </button>
          <button type="button" class="foot-btn" data-sound aria-pressed="true">
            Sound on
          </button>
          <button type="button" class="foot-btn" data-palette-open>
            <kbd>/</kbd> Commands
          </button>
        </span>
      </footer>
    </div>

    <div class="bot" data-bot aria-hidden="true">
      <svg class="bot-arrow" viewBox="0 0 16 18" width="16" height="18">
        <path d="M8 0 16 18H0Z"></path>
      </svg>
      <span class="bot-label" data-bot-label>
        go for it
      </span>
    </div>

    <Palette />
    {projects.length > 0 && (
      <>
        <ProjectOverlay projects={projects} open={open} />
        <Launcher projects={projects} />
      </>
    )}
    {docPages.length > 0 && <DocOverlay pages={docPages} open={doc} />}

    <script>
      import "../scripts/main";
    </script>
  </body>
</html>
