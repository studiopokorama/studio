---
import "@fontsource/bricolage-grotesque/800.css";
import "@fontsource/figtree/400.css";
import "@fontsource/figtree/600.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/600.css";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/showcase.css";
import { getImage } from "astro:assets";
import Launcher from "../components/Launcher.astro";
import Mark from "../components/Mark.astro";
import Palette from "../components/Palette.astro";
import ProjectOverlay from "../components/ProjectOverlay.astro";
import Showcase from "../components/Showcase.astro";
import Wordmark from "../components/Wordmark.astro";
import { CONTACT_EMAIL, GAME_URL, SITE_NAME } from "../config";
import type { Project } from "../projects";

interface Props {
  projects: Project[];
  /** A project page: the home page with this project open over it. */
  open?: Project;
}
const { projects, open } = Astro.props;

const site = SITE_NAME;
const title = open ? `${open.data.title} | ${site}` : site;
const description = open
  ? open.data.description
  : "Studio Pokorama is an independent digital studio making apps, games, software and media.";
if (!Astro.site) throw new Error("set `site` in astro.config.mjs");
const url = new URL(Astro.url.pathname, Astro.site).href;
const cover = open
  ? await getImage({
      src: open.data.images[0]!.src,
      width: 1200,
      format: "jpg",
    })
  : null;
const ogImage = new URL(cover?.src ?? "/og.png", Astro.site).href;
const ogAlt = open
  ? open.data.images[0]!.alt
  : "The studio pokorama wordmark in letter tiles, with the second o lifted out of its slot.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta name="theme-color" content="#121115" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    {!cover && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <canvas class="board" data-board aria-hidden="true"></canvas>
    <div class="found-words" data-found aria-hidden="true"></div>

    <div class="page">
      <header class="top">
        <nav class="top-actions" data-actions aria-label="Main">
          <a
            class="btn btn-secondary"
            data-contact
            href={`mailto:${CONTACT_EMAIL}`}
          >
            Contact us
          </a>
          <a class="btn btn-primary" data-cta href={GAME_URL}>
            Play Interior Design Game
          </a>
        </nav>
      </header>

      <main class="hero">
        <h1 class="sr-only">Studio Pokorama</h1>
        <Wordmark />
        <p class="lede">
          Apps, games and media.
          <br />
          Building piece by piece.
        </p>
        <Showcase projects={projects} />
      </main>

      <footer class="foot">
        <span class="foot-copy">© 2026 Studio Pokorama</span>
        {projects.length > 0 && (
          <button
            type="button"
            class="apps-btn"
            data-launcher-open
            aria-haspopup="dialog"
            aria-label="All projects"
          >
            <Mark size={60} />
          </button>
        )}
        <span class="foot-actions">
          <button type="button" class="foot-btn" data-reset hidden>
            Reset
          </button>
          <button type="button" class="foot-btn" data-sound aria-pressed="true">
            Sound on
          </button>
          <button type="button" class="foot-btn" data-palette-open>
            <kbd>/</kbd> Commands
          </button>
        </span>
      </footer>
    </div>

    <div class="bot" data-bot aria-hidden="true">
      <svg class="bot-arrow" viewBox="0 0 16 18" width="16" height="18">
        <path d="M8 0 16 18H0Z"></path>
      </svg>
      <span class="bot-label" data-bot-label>
        go for it
      </span>
    </div>

    <Palette />
    {projects.length > 0 && (
      <>
        <ProjectOverlay projects={projects} open={open} />
        <Launcher projects={projects} />
      </>
    )}

    <script>
      import "../scripts/main";
    </script>
  </body>
</html>
